# Secrets — never commit real credentials. Keep .env.example as the template.
.env

# Python
__pycache__/
*.pyc
.pytest_cache/

# Claude Code local state. Holds settings.local.json and, more importantly,
# .claude/worktrees/ — full working copies of the repo (models, GRANULE scratch
# data, even a Frontend/.env). None of that belongs in version control.
.claude/

# Generated by server/scl_to_csv.py from the .jp2 sitting beside it. One of
# these was committed at 88 MB -- larger than everything else in the repo put
# together. The .jp2 inputs stay tracked; the derived CSV is regenerable with
#   python server/scl_to_csv.py
server/GRANULE/**/*.csv

# Flutter tool crash reports
mobile/flutter_*.log

# JVM crash dumps (Gradle daemon crashes)
hs_err_pid*.log
**/hs_err_pid*.log
