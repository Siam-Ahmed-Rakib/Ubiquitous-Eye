# Copy this file to .env and set your Sentinel Hub credentials.
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Result cache database (optional). Paste the Supabase Postgres connection
# string here, e.g.
#   DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Leave blank to run without caching (every request hits Sentinel Hub).
DATABASE_URL=
